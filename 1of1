-- ¿este texto corresponde a un brainrot escogido?
function S.isSel(str)
	local n = norm(str)
	if n == "" then return false end
	for k in pairs(S.selected) do
		if n == k or (#k >= 5 and n:find(k, 1, true)) then return true end
	end
	return false
end
 
-- Revisa TODOS los textos de una tabla de datos (profundidad 2) sin necesitar saber los nombres de los campos
function S.matchTable(t, depth)
	depth = depth or 0
	if type(t) ~= "table" or depth > 2 then return false end
	local hit = false
	pcall(function()
		for _, v in pairs(t) do
			local tv = typeof(v)
			if tv == "string" then
				if S.isSel(v) then
					hit = true
					return
				end
			elseif tv == "Instance" then
				if S.isSel(v.Name) then
					hit = true
					return
				end
			elseif tv == "table" then
				if S.matchTable(v, depth + 1) then
					hit = true
					return
				end
			end
		end
	end)
	return hit
end
 
-- Revisa los textos visibles del overhead (TextLabels)
function S.matchOverhead(root)
	if not root then return false end
	local hit = false
	pcall(function()
		for _, d in ipairs(root:GetDescendants()) do
			if d:IsA("TextLabel") or d:IsA("TextButton") then
				local t = tostring(d.Text or ""):gsub("<[^>]->", "")
				if S.isSel(t) then
					hit = true
					return
				end
			end
		end
	end)
	return hit
end
 
-- Intenta adivinar el nombre del brainrot de un overhead (para la lista SCAN)
function S.guessName(root)
	local fallback
	pcall(function()
		for _, d in ipairs(root:GetDescendants()) do
			if d:IsA("TextLabel") or d:IsA("TextButton") then
				local t = tostring(d.Text or ""):gsub("<[^>]->", "")
				t = t:match("^%s*(.-)%s*$") or t
				if t:find("%a") and not t:find("%$") and not t:find("/s") and #t <= 40 then
					if d.Name:lower():find("name") then
						fallback = t
						return
					end
					fallback = fallback or t
				end
			end
		end
	end)
	return fallback
end
 
-- Muestra el banner si "want"; si antes lo forzamos y ya no toca, lo deja como estaba
function S.setBanner(banner, want)
	pcall(function()
		if want then
			if S.forced[banner] == nil then S.forced[banner] = banner.Visible end
			banner.Visible = true
		elseif S.forced[banner] ~= nil then
			banner.Visible = S.forced[banner]
			S.forced[banner] = nil
		end
	end)
end
 
function S.applyBanner(banner)
	local root = banner:FindFirstAncestorOfClass("BillboardGui") or banner.Parent
	local want = S.enabled and root ~= nil and S.matchOverhead(root)
	S.setBanner(banner, want)
end
 
function S.applyAll()
	for _, inst in ipairs(Workspace:GetDescendants()) do
		if inst.Name == "1OF1Banner" then S.applyBanner(inst) end
	end
end
 
