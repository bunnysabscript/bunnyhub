local function rebuild()
	for _, c in ipairs(selList:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
	for _, c in ipairs(detList:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
 
	local names = {}
	for k, v in pairs(S.selected) do names[#names + 1] = { k = k, v = v } end
	table.sort(names, function(a, b) return a.v:lower() < b.v:lower() end)
	for i, e in ipairs(names) do
		local row = mk("Frame", { Size = UDim2.new(1, -6, 0, 24), BackgroundColor3 = C.soft, BackgroundTransparency = 0.15, BorderSizePixel = 0, LayoutOrder = i, ZIndex = 13 }, selList)
		corner(row, 8)
		mk("TextLabel", { Position = UDim2.new(0, 8, 0, 0), Size = UDim2.new(1, -36, 1, 0), BackgroundTransparency = 1, Font = FM, Text = "🥝 " .. e.v, TextSize = 12, TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 14 }, row)
		local x = mk("TextButton", { Size = UDim2.fromOffset(22, 22), Position = UDim2.new(1, -24, 0, 1), BackgroundTransparency = 1, Text = "✕", Font = FT, TextSize = 12, TextColor3 = C.red, ZIndex = 15 }, row)
		x.MouseButton1Click:Connect(function()
			S.selected[e.k] = nil
			rebuild()
			S.applyAll()
		end)
	end
 
	for i, nm in ipairs(detected) do
		local on = S.selected[norm(nm)] ~= nil
		local b = mk("TextButton", {
			Size = UDim2.new(1, -6, 0, 24), BackgroundColor3 = on and Color3.fromRGB(24, 74, 48) or C.soft, BackgroundTransparency = 0.15,
			BorderSizePixel = 0, LayoutOrder = i, Font = FM, TextSize = 12, TextColor3 = on and C.lime or C.text,
			Text = (on and "✓ " or "    ") .. nm, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
			AutoButtonColor = false, ZIndex = 13,
		}, detList)
		corner(b, 8)
		mk("UIPadding", { PaddingLeft = UDim.new(0, 8) }, b)
		b.MouseButton1Click:Connect(function()
			local k = norm(nm)
			if S.selected[k] then S.selected[k] = nil else S.selected[k] = nm end
			rebuild()
			S.applyAll()
		end)
	end
end
 
local function addFromBox()
	local name = (inputBox.Text or ""):match("^%s*(.-)%s*$") or ""
	if name == "" then return end
	S.selected[norm(name)] = name
	inputBox.Text = ""
	rebuild()
	S.applyAll()
end
