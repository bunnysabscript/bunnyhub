scanBtn.MouseButton1Click:Connect(function()
	local found, seen = {}, {}
	for _, inst in ipairs(Workspace:GetDescendants()) do
		if inst.Name == "1OF1Banner" then
			local root = inst:FindFirstAncestorOfClass("BillboardGui") or inst.Parent
			local nm = root and S.guessName(root)
			if nm and not seen[norm(nm)] then
				seen[norm(nm)] = true
				found[#found + 1] = nm
			end
		end
	end
	table.sort(found, function(a, b) return a:lower() < b:lower() end)
	detected = found
	rebuild()
	if #found == 0 then print("[KIWI-1OF1] El SCAN no encontro overheads. Prueba acercarte a tu base o toca DUMP y mandame lo que salga en la consola.") end
end)
 
