if not getgenv().KiwiOOO_Hooked then
	local ok, err = pcall(function()
		local BrainrotCard = require(ReplicatedStorage.Shared.BrainrotCard)
		local OverheadController = require(ReplicatedStorage.Controllers.AnimalOverheadController)
 
		local oldObserve
		oldObserve = hookfunction(BrainrotCard.ObserveOneOfOne, function(record, callback)
			local st = getgenv().KiwiOOO
			if st then
				st.lastRecord = record
				if st.enabled and st.matchTable(record) then
					return oldObserve(record, function(_)
						callback(true)
					end)
				end
			end
			return oldObserve(record, callback)
		end)
 
		local originalPopulate
		originalPopulate = hookfunction(OverheadController.Populate, function(self, data)
			originalPopulate(self, data)
			pcall(function()
				local st = getgenv().KiwiOOO
				if not st then return end
				st.lastData = data
				local overhead = data and data.Overhead
				if not overhead then return end
				local banner = overhead:FindFirstChild("1OF1Banner", true)
				if not banner then return end
				local want = st.enabled and (st.matchTable(data) or st.matchOverhead(overhead))
				st.setBanner(banner, want)
			end)
		end)
 
		-- banners que aparezcan despues (esperamos un momento a que el juego les ponga el texto)
		Workspace.DescendantAdded:Connect(function(inst)
			if inst.Name == "1OF1Banner" then
				task.delay(0.25, function()
					local st = getgenv().KiwiOOO
					if st and inst.Parent then st.applyBanner(inst) end
				end)
			end
		end)
	end)
	if ok then
		getgenv().KiwiOOO_Hooked = true
	else
		warn("[KIWI-1OF1] No pude instalar los hooks:", err)
	end
end
 
